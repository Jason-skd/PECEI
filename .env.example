# PECEI environment — copy this file to `.env` (which is gitignored) and fill in.
# The CLI loads `.env` automatically at startup; the provider SDKs also read
# these directly when no --api-key / --base-url flag is passed.
# Precedence: CLI flag > environment (.env / shell export) > built-in default.

# ---- Anthropic (Claude) — provider: anthropic ----
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# ---- OpenAI / any OpenAI-compatible endpoint — provider: openai ----
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ---- DeepSeek (OpenAI-compatible) — provider: deepseek ----
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com   # already the default
